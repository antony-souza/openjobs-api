# PostgreSQL
POSTGRES_DB=openjobs
POSTGRES_USER=openjobs
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_USER=openjobs
RABBITMQ_PASSWORD=change-me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Gmail SMTP (use uma senha de app do Google; nunca a senha normal da conta)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=cole-a-senha-de-app-aqui

# Redis
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# JSON Web Token
JWT_EXPIRATION=86400000
# Base64 com pelo menos 32 bytes; substitua por uma chave exclusiva.
JWT_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Cloudflare R2
R2_ENABLED=false
R2_ACCOUNT_ID=seu-account-id
R2_ACCESS_KEY_ID=sua-access-key-id
R2_SECRET_ACCESS_KEY=sua-secret-access-key
R2_BUCKET_NAME=nome-do-bucket
R2_PUBLIC_URL=https://seu-dominio-publico
